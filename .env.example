# --- HTTP ---
PORT=3000
HOST=0.0.0.0

# Секрет вебхука GetCourse: ?secret=... или заголовок X-Webhook-Secret
WEBHOOK_SECRET=dev-secret

# --- База ---
# Путь к файлу SQLite. ":memory:" — для тестов.
DB_PATH=./data/app.db

# --- Bitrix24 ---
# Вложенные настройки задаются через двойное подчёркивание.
# stub    — ничего не отправляем наружу, пишем в лог, какой метод API
#           и с какими данными был бы вызван
# webhook — реальные вызовы через входящий вебхук портала
BITRIX__MODE=stub
# https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
BITRIX__WEBHOOK_URL=
BITRIX__STAGE_NEW=NEW
BITRIX__STAGE_PAID=WON
BITRIX__CATEGORY_ID=0
BITRIX__TIMEOUT_SEC=10

# --- WhatsApp ---
# stub — пишем текст сообщения в лог (и в таблицу messages)
WHATSAPP__MODE=stub

# --- Очередь доставки (outbox) ---
WORKER__ENABLED=true
WORKER__POLL_INTERVAL_SEC=1
WORKER__BATCH_SIZE=10
WORKER__MAX_ATTEMPTS=8
WORKER__BACKOFF_BASE_SEC=2
WORKER__BACKOFF_MAX_SEC=300

# --- Прочее ---
DEFAULT_COUNTRY_CODE=7
LOG_LEVEL=INFO
